# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Your site's address (http://localhost:3000 while testing, your real domain when live)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: Developers > API keys, and the price IDs of your two products
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HERO_PACK=
STRIPE_PRICE_SURPRISE_PACK=

# Cartoon maker (optional). Without it, hero cards show their type symbol instead of a picture.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
